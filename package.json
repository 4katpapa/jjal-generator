{
  "name": "speccard",
  "version": "3.2.1",
  "description": "자짤 생성툴 - PC 사양 카드 생성기",
  "main": "main.js",
  "author": "정신안차려?",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node --check main.js && node --check preload.js && node --check specReader.js && node --check jsonStore.js && node --check backgroundLibrary.js && node --check renderer/background-library.js && node --check renderer/spec-icons.js && node --check renderer/v2-core.js && node --check renderer/app.js && npm test",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.jjalgenerator.speccard",
    "productName": "자짤 생성툴",
    "compression": "maximum",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "specReader.js",
      "jsonStore.js",
      "backgroundLibrary.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      { "from": "assets/backgrounds", "to": "backgrounds", "filter": ["**/*.png"] }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "jjal-generator-v3.21-portable.exe"
    }
  }
}
